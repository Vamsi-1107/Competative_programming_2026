import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) 
    {
        Scanner sc = new Scanner(System.in);
        if(sc.hasNextLong())
        {
            long n = sc.nextLong();
            int k = sc.nextInt();
            
            if(((n >> k ) & 1) == 1)
            {
                System.out.println(1);
            }
            else
            {
                System.out.println(0);
            }
        }
        sc.close();
    }
}
