    public static void main(String[] args) 
    {
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int b = sc.nextInt();
        int t = sc.nextInt();
        int temp= 0;
        while(a!=0)
        {
            temp =a;
            a = a%b;
            b = temp;
        }
         if(t % b == 0)
         {
            System.out.print("YES");
         }
         else
         {
            System.out.print("NO");
         }
        
    }
